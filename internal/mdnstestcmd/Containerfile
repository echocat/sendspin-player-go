FROM docker.io/library/golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS build
WORKDIR /src
RUN mkdir -p /src/var/bin
COPY src/go.mod src/go.sum ./
RUN go mod download
COPY src/ ./
RUN CGO_ENABLED=1 go test -c -race -tags=e2e,mdns_e2e -o /src/var/bin/player.test .

FROM ghcr.io/astral-sh/uv:0.12.13@sha256:b485bd65cc2cf1c9a93b3554012c9c3778cf7b1b5fd3d3096ce9e1226c97e1e6 AS uv
FROM docker.io/library/python:3.13.9-slim-bookworm@sha256:b685a4fa58bb19d1814d78a1ec0f0208f351452724f78b20212c984d6e124a34
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=never
WORKDIR /workspace
ENV UV_PROJECT_ENVIRONMENT=/workspace/var/python/e2e PYTHONPYCACHEPREFIX=/workspace/var/python/pycache
RUN mkdir -p /workspace/var/bin
COPY src/internal/e2e/ ./internal/e2e/
RUN uv sync --locked --project internal/e2e --python /usr/local/bin/python3.13
COPY --from=build /src/var/bin/player.test ./var/bin/player.test
COPY src/LICENSE src/NOTICES.md ./
COPY src/LICENSES/ ./LICENSES/
COPY src/internal/mdns/LICENSE ./LICENSES/zeroconf-MIT.txt
ENTRYPOINT ["/workspace/var/bin/player.test", "-test.v", "-test.run=^TestMDNS", "-test.timeout=2m"]
