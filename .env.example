# Optional E2E hardware configuration. Copy to .env; real process variables win.
# Empty/missing devices skip the corresponding hardware tests.
# Non-empty invalid devices fail the test. No mixer or volume is changed.

# Use identifiers for the native backend on your OS; no default device is chosen.
SENDSPIN_TEST_PLAYBACK_DEVICE=
SENDSPIN_TEST_CAPTURE_DEVICE=

# Optional: alsa, pipewire, wasapi or coreaudio. Empty uses platform selection.
SENDSPIN_TEST_AUDIO_BACKEND=

# Optional existing reference WAV. Empty generates a synthetic reference in Go.
SENDSPIN_TEST_REFERENCE_WAV=
